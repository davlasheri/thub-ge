# Canonical host: the old thub.ge domain and www.teslahub.ge permanently
# redirect to https://teslahub.ge, keeping the path and query string.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /
RewriteCond %{HTTP_HOST} ^(www\.)?thub\.ge$ [NC,OR]
RewriteCond %{HTTP_HOST} ^www\.teslahub\.ge$ [NC]
RewriteRule ^(.*)$ https://teslahub.ge/$1 [R=301,L]
</IfModule>

# SPA routing: serve real files/directories as-is, everything else → index.html
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^api/ - [L]
RewriteRule . /index.html [L]
</IfModule>

# Sensible caching: hashed assets forever, HTML always revalidated
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType text/css "access plus 1 year"
ExpiresByType image/png "access plus 1 month"
ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
